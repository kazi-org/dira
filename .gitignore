# dira's derived read cache — rebuildable from .dira/entries/ at any time via
# `dira reindex`. Never committed: if the cache and the entry files ever disagree,
# the files win (dec-0002).
.dira/cache/

# Go build output
/dira
/dist/
*.test
*.out

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# Mockup render harness: playwright lives in the session scratchpad, symlinked in.
node_modules

# Mockup renders: derived artifacts, reproducible in one command
# (`node docs/design/scripts/render.mjs r1`). Same logic as .dira/cache/ —
# the source is the record, the render is exhaust.
docs/design/renders/

# A global ~/.gitignore on this machine contains `plan.md`, which silently swallowed
# docs/plan.md — the L0 program plan — for this repo's entire history. Repo-level
# .gitignore takes precedence over core.excludesFile, so this negation restores it.
# scripts/coverage.py reads docs/plan.md, so an untracked plan.md would make the
# coverage gate fail on a fresh clone for the wrong reason.
!docs/plan.md
