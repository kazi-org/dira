---
import Layout from "../layouts/Layout.astro";
import verbTour from "../generated/verb-tour.json";
---
<Layout title="Command reference — dira" description="Every dira command, with usage and flags generated from the CLI. Capture, review, recall, check, and supersede decisions.">
<main id="main" class="container">
  <section class="page-heading"><p class="section-id">Reference / The CLI</p><h1>A small vocabulary.<br />A lasting memory.</h1><p class="intro">Capture, recall, and check your decisions from the terminal. New to dira? <a href="/guide/">Start with the walkthrough.</a></p></section>
  <div class="guide-layout">
    <nav class="guide-nav" aria-label="Commands"><p class="section-id">Jump to a command</p>{verbTour.map(v => <a href={`#${v.name}`}>dira {v.name}</a>)}</nav>
    <div class="guide-content">
      <p class="note prose">This reference comes from the current source build. Your installed release may differ. Run <code>dira --help</code> to see your version’s commands.</p>
      {verbTour.map(v => <article id={v.name} class="command-entry"><h2><a href={`#${v.name}`}>dira {v.name}</a></h2><p>{v.line}</p><details open={['log','check'].includes(v.name)}><summary>Usage and flags</summary><pre class="code"><code>{v.output}</code></pre></details></article>)}
    </div>
  </div>
</main>
</Layout>
