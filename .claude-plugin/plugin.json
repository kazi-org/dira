{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "dira",
  "displayName": "dira",
  "version": "0.1.0",
  "description": "dira gives your AI coding agent a memory for why. A git-native decision ledger: hooks capture decisions as you work, one-keystroke review stages them, and every new session starts with the brief — what is blocked, what was decided, and why. Requires the dira binary (brew install kazi-org/tap/dira or build from source).",
  "author": { "name": "kazi-org", "url": "https://github.com/kazi-org/dira" },
  "homepage": "https://github.com/kazi-org/dira",
  "repository": "https://github.com/kazi-org/dira",
  "license": "Apache-2.0",
  "keywords": ["dira", "decision-memory", "adr", "hooks", "agent"],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "dira brief --context --chain 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "dira sniff --stage --quiet 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "dira sniff --deep --stage 2>/dev/null || true",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
